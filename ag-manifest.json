{
  "version": "2.4.1",
  "include": [
    ".claude/agents/**",
    ".claude/skills/**",
    ".claude/skills/**/.??*",
    ".claude/hooks/**",
    ".claude/settings.json",
    ".codex/**",
    "CLAUDE.md",
    "AGENTS.md",
    "process/development-protocols/**",
    "process/context/planning/example-*.md",
    "process/_seeds/**",
    "process/_seeds/**/.gitkeep",
    "process/_seeds/**/.gitignore",
    "process/_seeds/**/.env.example"
  ],
  "exclude": [
    "process/context/all-context.md",
    "process/features/**",
    "process/general-plans/**",
    "**/.git/**",
    "**/.logs/**",
    ".codex/statusline.cjs",
    ".claude/skills/ag-chrome-devtools/scripts/node_modules/**"
  ],
  "strip": [],
  "merge": [
    ".claude/settings.json"
  ],
  "copyIfMissing": [
    "process/context/planning/example-*.md"
  ],
  "symlinks": {
    ".agents/skills": "../.claude/skills"
  },
  "kitOnly": [
    "README.md",
    "README-preview*.html",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "TRADEMARK.md",
    "LICENSE",
    "docs/**",
    "assets/**",
    ".github/**",
    "resolve-manifest.mjs",
    "install.sh",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    ".prettierignore",
    ".prettierrc",
    ".gitattributes",
    ".claude/skills/ag-audit-ag/**",
    ".claude/skills/ag-publish/**",
    ".claude/hooks/lib/__tests__/**",
    ".codex/hooks/lib/__tests__/**"
  ]
}
