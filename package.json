{
  "name": "agent-skills-kit",
  "version": "2.4.2",
  "description": "Meta development harness for AI coding agents",
  "main": "resolve-manifest.mjs",
  "bin": {
    "ag-cli": "./bin/ag-cli"
  },
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "bun .codex/hooks/lib/__tests__/statusline-suite.cjs",
    "validate": "node scripts/run-audit-parallel.mjs",
    "audit": "./scripts/run-audit-parallel.mjs",
    "format": "bunx biome format --write . && bunx prettier --write \"**/*.md\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25",
    "js-yaml": "^4.1.0",
    "prettier": "^3.5.0",
    "typescript": "^6"
  },
  "author": "ngxccc & withkynam",
  "license": "MIT"
}
