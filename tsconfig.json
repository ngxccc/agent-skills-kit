{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "checkJs": true,
    "allowJs": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [".omp/**/*.ts", "**/*.ts", "**/*.js", "**/*.mjs", "**/*.cjs"],
  "exclude": ["node_modules", "**/node_modules"]
}
