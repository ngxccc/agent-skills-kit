{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json.schemastore.org/ag-custom-config.json",
  "title": "Agent Skills Kit Custom Configuration",
  "description": "JSON Schema for Agent Skills Kit ag-cli configuration file (.ag-custom-config.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema URI for validation"
    },
    "version": {
      "type": "string",
      "description": "Agent Skills Kit harness version"
    },
    "updatedAt": {
      "type": "string",
      "description": "ISO 8601 timestamp of last configuration update"
    },
    "installMode": {
      "type": "string",
      "enum": ["copy", "symlink"],
      "description": "Harness installation mode (copy files or dev symlinks)"
    },
    "symlinkScope": {
      "type": "string",
      "enum": ["bulk", "fine-grained"],
      "description": "Symlink granularity scope"
    },
    "kitRepoPath": {
      "type": "string",
      "description": "Path to local agent-skills-kit repository"
    },
    "targets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Selected target layers for installation"
    },
    "symlinkTargets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Selected target layers for dev symlinks"
    },
    "skills": {
      "type": "object",
      "description": "Skill selection configuration",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["all", "custom", "minimal", "select"],
          "description": "Skill inclusion selection mode"
        },
        "include": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicitly included skill names"
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicitly excluded skill names"
        },
        "topics": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Active feature topic filters"
        }
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "description": "Installer safety and preservation options",
      "properties": {
        "preserveUserContent": {
          "type": "boolean",
          "description": "Preserve existing user custom content during updates"
        },
        "refuseOverwriteNonSymlinkDir": {
          "type": "boolean",
          "description": "Refuse to overwrite non-symlink directories when switching modes"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["version", "installMode"],
  "additionalProperties": true
}
